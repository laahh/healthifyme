# Salin ke `docker-compose.env` (opsional) atau set variabel yang sama di `.env` di folder yang sama dengan docker-compose.yml.
# Compose memuat `.env` otomatis untuk substitusi ${VAR}.

# Wajib kuat di production (min. 16 karakter — sama dengan server/src/config/env.js)
JWT_SECRET=dev-only-change-me-min-16-chars-ok

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=health_app
MYSQL_USER=health
MYSQL_PASSWORD=health

# URL API untuk build frontend (browser memanggil host ini). Default: port API yang di-publish compose.
VITE_API_URL=http://localhost:8788

# Origin halaman web (default port 5174 agar tidak bentrok dengan Airbyte / layanan lain di 8080).
CORS_ORIGIN=http://localhost:5174

# Opsional: override port publish
# WEB_PUBLISH_PORT=5174
# API_PUBLISH_PORT=8788
# MYSQL_PUBLISH_PORT=3307

# Opsional: sama seperti .env root untuk fitur Supabase / Gemini di build FE
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_GEMINI_API_KEY=

# AI di container `api` (Vertex prioritas; mount SA JSON + set path di GOOGLE_APPLICATION_CREDENTIALS)
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.0-flash-001
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa.json
# GEMINI_API_KEY=

# --- Strava OAuth (opsional) ---
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://localhost:8788/api/v1/strava/callback
# STRAVA_SCOPES=read,activity:read_all,profile:read_all
# STRAVA_FE_REDIRECT=http://localhost:5174/strava

# --- MCU Postgres via SSH jump (opsional; local API / volume PEM) ---
# SSH_HOST=
# SSH_PORT=22
# SSH_USER=ubuntu
# SSH_PKEY=/secrets/JumpHostVPC2.pem
# PG_HOST=
# PG_PORT=5432
# PG_SSH_HOST=127.0.0.1
# PG_SSH_LOCAL_PORT=5433
# PG_SSH_DATABASE=
# PG_SSH_USER=
# PG_SSH_PASSWORD=
# MCU_PG_SID_COLUMN=
# MCU_PG_DATE_COLUMN=

# --- Setelah `docker compose up -d` ---
# Buat user uji (SID = password awal):
#   docker compose exec api node scripts/seed-user.mjs --sid=CONTOH_SID
